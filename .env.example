# Optional explicit TOML configuration location; relative to the current directory.
ELIXIR_ECHO_CONFIG=./configs/elixir_echo_baseline.toml

# Paths are resolved from the current directory unless written in the TOML file,
# where relative paths are resolved from that file's directory.
ELIXIR_ECHO_DATA_ROOT=./data
ELIXIR_ECHO_FIRSTLIGHT_ROOT=
ELIXIR_ECHO_DATASET_PATH=./data/full_episode_cache
ELIXIR_ECHO_OUTPUT_PATH=./runs
ELIXIR_ECHO_GAME_ASSETS_PATH=
ELIXIR_ECHO_MUMU_MANAGER_PATH=
ELIXIR_ECHO_ADB_EXECUTABLE=adb
ELIXIR_ECHO_DEVICE_SERIAL=

# Safe defaults. Training still requires the explicit --run switch.
ELIXIR_ECHO_DEVICE=cpu
ELIXIR_ECHO_MAX_EPISODES=1
ELIXIR_ECHO_CHECKPOINT_EVERY=10
